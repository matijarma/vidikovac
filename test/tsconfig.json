// Unit tests of app code (vitest project `unit`) in lib.dom, plus e2e/ and
// scripts/*.ts. Vitest also reads this file (the nearest tsconfig.json) when
// it transpiles a test, so `target` must stay ES2022.
// Unit tests of worker code are in tsconfig.unit-worker.json, tests that need
// both libraries in tsconfig.unit-mixed.json, workerd tests in
// tsconfig.workers.json. scripts/typecheck-tests.mjs runs all four and checks
// that every test file belongs to exactly one of them.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../e2e/**/*.ts", "../scripts/**/*.ts", "../app/src/vite-env.d.ts"],
  "exclude": [
    // workerd: tsconfig.workers.json
    "./**/*.workers.test.ts",
    "./workers-env.d.ts",
    // worker code: tsconfig.unit-worker.json
    "./feed/**",
    "./open/**",
    "./pairing/**",
    "./smoke/**",
    "./twin/**",
    "./docs/prijava.test.ts",
    "./e2e/local-network.test.ts",
    "./scripts/frames-sample.test.ts",
    // both: tsconfig.unit-mixed.json
    "./city/city.test.ts",
    "./city/reliability.test.ts"
  ]
}
