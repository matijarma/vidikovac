    "typecheck": "tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p app/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "a11y:lighthouse": "node scripts/lighthouse-a11y.mjs",
    "review:visual": "node scripts/review-experience.mjs",
    "gtfs:routes": "node scripts/gtfs-routes.mjs",
    "build:network": "node scripts/gtfs-shapes.mjs",
    "build:trips": "node scripts/gtfs-trips.mjs",
    "check:izvori": "node scripts/check-plan-links.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "fast-xml-parser": "^5.2.5",
    "gtfs-realtime-bindings": "^1.1.1",
    "jsqr": "1.4.0",
    "maplibre-gl": "6.4.1",
    "pmtiles": "4.5.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@playwright/test": "^1.61.1",
    "chrome-launcher": "^1.2.1",
    "happy-dom": "^20.14.3",
