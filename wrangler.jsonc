{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vidikovac", // production Worker serving https://zagreb.aningfilm.hr
  "workers_dev": false,
  "preview_urls": false,
  // Runtime values (SESSION_MINUTES, NETWORK_CHECK, ...) live in the Cloudflare
  // dashboard, not in git. Without keep_vars a Git-connected build would wipe them.
  "keep_vars": true,
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "zagreb.aningfilm.hr", "custom_domain": true }],
  "assets": {
    "directory": "app/dist",
    "binding": "ASSETS",
    // Only these paths reach the Worker; every other GET is served straight from
    // the static-asset store (free and off the request meter). /hitno is
    // server-rendered (open safety tier), /open/* is derived data, /stats is the
    // Access-gated operator page, /statistika/ the public report (the one page
    // allowed in a same-origin frame, worker/routes/statistika.ts). The HTML pages pass through the Worker too, only
    // so their response can carry Cache-Control: no-transform (the edge would
    // otherwise inject the zone's Web Analytics beacon, which the CSP blocks).
    "run_worker_first": ["/api/*", "/ws/*", "/maps/*", "/hitno", "/hitno/*", "/open", "/open/*", "/stats", "/stats/*", "/", "/d", "/d/", "/s", "/s/", "/kiosk", "/kiosk/", "/izvori", "/izvori/", "/privatnost", "/privatnost/", "/pristupacnost", "/pristupacnost/", "/prijava", "/prijava/", "/statistika", "/statistika/"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BEACON_DO", "class_name": "BeaconDO" }, // one per public screen: mints rotating codes
      { "name": "ROOM_DO", "class_name": "RoomDO" }, // one per session: both devices, expiry alarm
      { "name": "INDEX_DO", "class_name": "IndexDO" }, // singleton: code -> beacon | room
      { "name": "METRICS_DO", "class_name": "MetricsDO" }, // singleton: identifier-free counters
      { "name": "TWIN_DO", "class_name": "TwinDO" },
      { "name": "CATALOGUE_DO", "class_name": "CatalogueDO" } // serialized reference/schedule ingestion
    ]
  },
  // Never edit an existing tag; a new class arrives with a new tag (R-TE14).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BeaconDO", "RoomDO", "IndexDO", "MetricsDO"] },
    { "tag": "v2", "new_sqlite_classes": ["TwinDO"] },
    { "tag": "v3", "new_sqlite_classes": ["CatalogueDO"] }
  ],
  "kv_namespaces": [
    { "binding": "FEED", "id": "8cb66336f0424a8ea1246bfc6a4ae29b" } // last-good copy of every feed module
  ],
  // Workers AI: one-line briefs for the kiosk ticker (worker/feed/brief.ts).
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "MAPS", "bucket_name": "vidikovac-maps" },
    { "binding": "RECORDINGS", "bucket_name": "vidikovac-feed" } // raw ZET frames for replay; 7-day expiry rule set on the bucket itself
  ],
  "ratelimits": [
    { "name": "RL_SCAN", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } }, // POST /api/scan per IP
    { "name": "RL_DATA", "namespace_id": "2002", "simple": { "limit": 240, "period": 60 } }, // /api/data per data token
    { "name": "RL_OPEN", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } } // open routes per IP
  ],
  "triggers": { "crons": ["*/5 * * * *"] }, // warms the slow feed modules into KV
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
  "build": {
    "command": "npm run build",
    "watch_dir": ["worker", "app/src", "app/index.html", "app/d", "app/s", "app/kiosk", "app/izvori", "app/privatnost", "app/pristupacnost", "app/prijava", "app/statistika"]
  }
}
